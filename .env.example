# ============================================================
# Fichier de configuration MobiTranz
# Type : Variables d'environnement du projet
# Description : Modèle pour les variables d'environnement
# ============================================================

# Configuration Serveur
APP_NAME=MobiTranz
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=changeme_generate_with_secrets_token_hex_32

# Configuration Base de Données
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mobitranz

# Configuration Redis
REDIS_URL=redis://localhost:6379/0

# Configuration JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Configuration MoovMoney (API Gabon)
MOOVMONEY_API_URL=https://api.moovmoney.ga/v1
MOOVMONEY_API_KEY=your_api_key_here
MOOVMONEY_API_SECRET=your_api_secret_here

# Configuration Airtel Money (API Gabon)
AIRTELMONEY_API_URL=https://api.airtelmoney.ga/v1
AIRTELMONEY_API_KEY=your_api_key_here
AIRTELMONEY_API_SECRET=your_api_secret_here

# Configuration Firebase (Push Notifications)
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-credentials.json

# Configuration Cloudinary (Stockage fichiers)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Configuration Sentry (Monitoring)
SENTRY_DSN=https://xxx@sentry.io/xxx

# Configuration Rate Limiting
RATE_LIMIT_AUTH_REQUESTS=5
RATE_LIMIT_AUTH_WINDOW=900
RATE_LIMIT_PAYMENT_REQUESTS=10
RATE_LIMIT_PAYMENT_WINDOW=60
RATE_LIMIT_GENERAL_REQUESTS=100
RATE_LIMIT_GENERAL_WINDOW=60

# Configuration Fuseau Horaire
TZ=Africa/Libreville