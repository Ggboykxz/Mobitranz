# ============================================================
# MobiTranz - Configuration Production
# Generer les secrets avec: openssl rand -hex 32
# ============================================================

# ============================================================
# APPLICATION
# ============================================================
APP_NAME=MobiTranz
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# ============================================================
# SECURITY - GENERER AVEC: openssl rand -hex 32
# ============================================================
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
AES_MASTER_KEY=CHANGE_ME_openssl_rand_hex_32

# ============================================================
# DATABASE - PostgreSQL
# ============================================================
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://mobitranz:${DB_PASSWORD}@db:5432/mobitranz

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://redis:6379/0

# ============================================================
# API KEYS - Paiements Gabon
# ============================================================
MOOVMONEY_API_URL=https://api.moovmoney.ga/v1
MOOVMONEY_API_KEY=CHANGE_ME
MOOVMONEY_API_SECRET=CHANGE_ME

AIRTELMONEY_API_URL=https://api.airtelmoney.ga/v1
AIRTELMONEY_API_KEY=CHANGE_ME
AIRTELMONEY_API_SECRET=CHANGE_ME

# ============================================================
# ADMIN CREDENTIALS
# ============================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_API_KEY=CHANGE_ME

# ============================================================
# MINISTRY WEBHOOKS
# ============================================================
MINISTRY_TRANSPORT_WEBHOOK=https://transport.gouv.ga/webhook
MINISTRY_INTERIOR_WEBHOOK=https://interieur.gouv.ga/webhook
MINISTRY_API_KEY=CHANGE_ME

# ============================================================
# STORAGE - MinIO (Optionnel)
# ============================================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_VIDEOS=trip-recordings
MINIO_BUCKET_KYC=kyc-documents

# ============================================================
# NOTIFICATIONS - Firebase (Optionnel)
# ============================================================
FIREBASE_CREDENTIALS_PATH=/app/config/firebase-credentials.json

# ============================================================
# CLOUDINARY (Optionnel)
# ============================================================
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# ============================================================
# SENTRY - Monitoring (Optionnel)
# ============================================================
SENTRY_DSN=

# ============================================================
# AFRICASTALKING - SMS (Optionnel)
# ============================================================
AFRICASTALKING_API_KEY=CHANGE_ME
AFRICASTALKING_USERNAME=CHANGE_ME
AFRICASTALKING_SENDER_ID=CHANGE_ME

# ============================================================
# CORS
# ============================================================
ALLOWED_ORIGINS=https://mobitranz.ga,https://admin.mobitranz.ga,https://api.mobitranz.ga

# ============================================================
# GRAFANA
# ============================================================
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_AUTH_REQUESTS=5
RATE_LIMIT_AUTH_WINDOW=900
RATE_LIMIT_PAYMENT_REQUESTS=10
RATE_LIMIT_PAYMENT_WINDOW=60
RATE_LIMIT_GENERAL_REQUESTS=100
RATE_LIMIT_GENERAL_WINDOW=60

# ============================================================
# JWT
# ============================================================
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ============================================================
# TIMEZONE
# ============================================================
TZ=Africa/Libreville
